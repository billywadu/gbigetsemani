# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase Database)
# ==============================================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/cmsgereja?schema=public"

# Supabase Session/Direct connection string (untuk direct migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# ==============================================================================
# STORAGE PROVIDER SETTING
# ==============================================================================
# Opsi: "local" | "cloudinary" | "supabase"
STORAGE_PROVIDER="cloudinary"


# ==============================================================================
# CLOUDINARY CONFIGURATION (Media, Image & Document Storage)
# ==============================================================================
# Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"


# ==============================================================================
# SUPABASE CONFIGURATION (Project API, Auth, & Bucket Storage)
# ==============================================================================
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="cms-dokumen"


# ==============================================================================
# APPLICATION & SESSION SECURITY
# ==============================================================================
SESSION_SECRET="your-random-32-character-secret-key-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"